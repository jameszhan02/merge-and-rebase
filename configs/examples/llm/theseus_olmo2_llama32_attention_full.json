{
  "method": {
    "name": "theseus_gqa",
    "params": {
      "num_batches": 100,
      "seed": 0,
      "seq_align": "interpolate",
      "device_transform": "gpu",
      "activation_cache_dir": "artifacts/theseus/activation_cache",
      "activation_cache_mode": "auto",
      "parameter_filter": {
        "include": [
          "self_attn.q_proj.weight",
          "self_attn.k_proj.weight",
          "self_attn.v_proj.weight",
          "self_attn.o_proj.weight"
        ]
      }
    }
  },
  "depth_alignment": {"rule": "index_match"},
  "alpha": {"search": false, "value": 0.05},
  "save": {"merged": "artifacts/theseus/full_attention_alpha_0.05.pt"},
  "source_model_name_or_path": "/data/shared_ckpt/OLMo-2-0425-1B",
  "target_model_name_or_path": "/data/shared_ckpt/Llama-3.2-1B",
  "model_kind": "causal_lm",
  "model_arch": "auto",
  "tuned_bodies": {"gsm8k": "/data/shared_ckpt/opd_teacher"},
  "device": "cuda",
  "dtype": "bf16",
  "seed": 0,
  "calibration_batch_size": 4,
  "calibration_max_length": 192,
  "calibration_dataset": {
    "path": "gsm8k",
    "name": "main",
    "split": "train",
    "text_columns": ["question", "answer"],
    "text_template": "{question}\n{answer}"
  },
  "harness_tasks": ["gsm8k"],
  "harness_num_fewshot": 0,
  "harness_batch_size": 4
}
